{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academic Value Audit — normalized input v1.4",
  "description": "设计契约：由自然语言入口补齐默认设置；不要求用户手工填写。",
  "type": "object",
  "required": ["schema_version", "raw_request", "targets", "scope", "retrieval", "evaluation", "quality_policy", "output"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.4"},
    "raw_request": {"type": "string", "minLength": 1},
    "targets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target_id", "type", "label"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "type": {"enum": ["paper", "paper_set", "report", "patent", "proposal", "award_material", "person", "group", "mixed"]},
          "label": {"type": "string", "minLength": 1},
          "affiliation": {"type": ["string", "null"]},
          "identifiers": {"type": "object", "additionalProperties": {"type": "string"}},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["as_of", "time_perspectives", "dimensions", "analysis_mode"],
      "properties": {
        "topic": {"type": ["string", "null"]},
        "period": {
          "type": "object", "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
            "end": {"type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"}
          }
        },
        "as_of": {"type": "string", "format": "date"},
        "timezone": {"type": "string", "default": "Asia/Shanghai"},
        "time_perspectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["origin", "audit", "forecast"]}},
        "dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["academic", "industrial", "social", "exploratory", "resources"]}},
        "regions": {"type": "array", "items": {"type": "string"}},
        "analysis_mode": {"enum": ["comprehensive", "sampled"]},
        "sampling": {
          "type": "object", "additionalProperties": false,
          "required": ["user_requested", "method", "frame", "limits"],
          "properties": {
            "user_requested": {"const": true},
            "method": {"enum": ["probability", "purposive"]},
            "frame": {"type": "string", "minLength": 1},
            "strata": {"type": "array", "items": {"type": "string"}},
            "sample_size": {"type": "integer", "minimum": 1},
            "seed": {"type": ["integer", "null"]},
            "limits": {"type": "string", "minLength": 1}
          }
        },
        "decision_context": {"type": ["string", "null"]}
      },
      "allOf": [{
        "if": {"properties": {"analysis_mode": {"const": "sampled"}}, "required": ["analysis_mode"]},
        "then": {"required": ["sampling"]},
        "else": {"not": {"required": ["sampling"]}}
      }]
    },
    "retrieval": {
      "type": "object", "additionalProperties": false,
      "required": ["include_relevant_si", "use_existing_authorized_access"],
      "properties": {
        "include_relevant_si": {"type": "boolean", "default": true},
        "use_existing_authorized_access": {"type": "boolean", "default": true},
        "languages": {"type": "array", "items": {"type": "string"}},
        "extra_service_spend_limit": {"type": "number", "minimum": 0, "default": 0},
        "spend_currency": {"type": "string", "default": "CNY"},
        "access_notes": {"type": "string", "description": "仅保存授权范围说明；不保存密码、Cookie 或 API 密钥。"}
      }
    },
    "evaluation": {"$ref": "./decision-quality.schema.json#/$defs/evaluation_settings"},
    "quality_policy": {"$ref": "./evidence-quality.schema.json#/$defs/policy"},
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "formats", "composite_score"],
      "properties": {
        "language": {"type": "string", "default": "zh-CN"},
        "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["markdown", "json", "csv"]}},
        "composite_score": {"type": "boolean", "default": false},
        "preference_specification": {"type": "string", "minLength": 1, "description": "综合分的评价对象、利益主体、效用锚点、权重、缺失处理及敏感性方法。"},
        "directory": {"type": "string"}
      },
      "allOf": [{
        "if": {"properties": {"composite_score": {"const": true}}, "required": ["composite_score"]},
        "then": {"required": ["preference_specification"]}
      }]
    },
    "extensions": {"type": "object"}
  }
}
